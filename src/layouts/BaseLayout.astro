---
import '../styles/manga-global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Mi sitio personal - Portfolio, proyectos y más" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '/';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Permanent+Marker&family=Rock+Salt&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="manga-paper text-manga-black min-h-screen">
    <slot />
  </body>
</html>
