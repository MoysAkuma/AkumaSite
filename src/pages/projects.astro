---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import projectsData from '../data/projects.json';

const featuredProjects = projectsData.projects.filter(p => p.featured);
const otherProjects = projectsData.projects.filter(p => !p.featured);
---

<BaseLayout title="Proyectos">
  <Navbar />
  
  <!-- Header con estilo manga -->
  <section class="py-16 bg-manga-cream relative overflow-hidden">
    <div class="absolute inset-0 screentone-light opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-6xl font-black text-manga-black mb-4 uppercase">
        <span class="inline-block border-b-6 border-accent-red pb-2">💻 Proyectos</span>
      </h1>
      <p class="text-xl text-manga-dark-gray font-bold">Proyectos personales</p>
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="py-16 bg-manga-paper">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-black mb-8 text-manga-black uppercase">
          <span class="border-b-5 border-accent-red pb-2 inline-block">⭐ Proyectos Destacados</span>
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {featuredProjects.map((project) => (
            <article class="manga-panel-skewed panel-appear overflow-hidden">
              <div class="aspect-video bg-manga-dark-gray flex items-center justify-center border-b-5 border-manga-black">
                <span class="text-8xl">💻</span>
              </div>
              <div class="p-8 relative">
                <div class="absolute top-0 right-0 w-0 h-0 border-t-[40px] border-t-accent-red border-l-[40px] border-l-transparent"></div>
                <h3 class="text-3xl font-black mb-3 text-manga-black uppercase">{project.title}</h3>
                <p class="text-manga-dark-gray mb-4 font-medium">{project.description}</p>
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.tags.map((tag) => (
                    <span class="px-3 py-1 bg-manga-black text-white text-xs font-black uppercase border-2 border-manga-black shadow-manga-sm">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex gap-4">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="manga-button text-sm"
                    >
                      💻 Código
                    </a>
                  )}
                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="manga-button-red text-sm"
                    >
                    🚀 Try it!
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Projects -->
  {otherProjects.length > 0 && (
    <section class="py-16 bg-manga-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-black mb-8 text-manga-black uppercase">
          <span class="border-b-5 border-accent-red pb-2 inline-block">📂 Otros Proyectos</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherProjects.map((project) => (
            <article class="manga-panel manga-zoom panel-appear overflow-hidden">
              <div class="aspect-video bg-manga-light-gray flex items-center justify-center border-b-3 border-manga-black">
                <span class="text-6xl">💻</span>
              </div>
              <div class="p-6 relative">
                <div class="absolute top-0 right-0 w-0 h-0 border-t-[25px] border-t-accent-red border-l-[25px] border-l-transparent"></div>
                <h3 class="text-xl font-black mb-2 text-manga-black uppercase">{project.title}</h3>
                <p class="text-manga-dark-gray mb-4 text-sm font-medium">{project.description}</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="px-2 py-1 bg-manga-black text-white text-xs font-black uppercase">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex gap-3">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="manga-button text-xs"
                    >
                      💻 Ver código
                    </a>
                  )}
                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="manga-button text-xs"
                    >
                     🚀 Try it!
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>
