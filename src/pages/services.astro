---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import servicesData from '../data/services.json';
import profileData from '../data/profile.json';
---

<BaseLayout title="Servicios - Mi Sitio Personal">
  <Navbar />
  
  <!-- Header con estilo manga -->
  <section class="py-16 bg-manga-cream relative overflow-hidden">
    <div class="absolute inset-0 screentone-light opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-6xl font-black text-manga-black mb-4 uppercase">
        <span class="inline-block border-b-6 border-accent-red pb-2">🚀 Servicios</span>
      </h1>
      <p class="text-xl text-manga-dark-gray font-bold">Soluciones profesionales para tus proyectos digitales</p>
    </div>
  </section>

  <section class="py-16 bg-manga-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {servicesData.services.map((service, index) => (
          <article class="manga-panel panel-appear relative overflow-hidden" style={`animation-delay: ${index * 0.1}s`}>
            <div class="absolute top-0 right-0 w-0 h-0 border-t-[50px] border-t-accent-red border-l-[50px] border-l-transparent"></div>
            <div class="text-6xl mb-4">{service.icon}</div>
            <h3 class="text-3xl font-black mb-3 text-manga-black uppercase">{service.title}</h3>
            <p class="text-manga-dark-gray mb-6 font-medium">{service.description}</p>
            
            <div class="mb-6">
              <h4 class="font-black mb-3 text-manga-black uppercase text-sm">⚡ Incluye:</h4>
              <ul class="space-y-2">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent-red font-black text-lg">▶</span>
                    <span class="text-manga-dark-gray font-medium">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 border-t-3 border-manga-black">
              <p class="text-3xl font-black text-accent-red">{service.price}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-accent-red relative overflow-hidden border-t-6 border-manga-black">
    <div class="absolute inset-0 screentone-dark opacity-10"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="speech-bubble mx-auto mb-8 bg-white">
        <h2 class="text-3xl font-black text-manga-black">¿Tienes un proyecto en mente?</h2>
      </div>
      <p class="text-2xl mb-10 text-white font-black uppercase">
        💬 Hablemos sobre cómo puedo ayudarte a hacer realidad tus ideas
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a
          href={profileData.social.email}
          class="manga-button px-10 py-4 text-lg"
        >
          📧 Contactar Ahora
        </a>
        <a
          href={import.meta.env.BASE_URL || '/'}
          class="px-10 py-4 text-lg bg-manga-black text-white border-3 border-manga-black shadow-manga-lg font-bold uppercase hover:transform hover:-translate-y-1 hover:shadow-manga-xl transition-all"
        >
          🎨 Ver Portfolio
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
