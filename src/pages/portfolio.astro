---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import portfolioData from '../data/portfolio.json';

const baseUrl = import.meta.env.BASE_URL || '/';
const categories = [...new Set(portfolioData.portfolio.map(item => item.category))];
---

<BaseLayout title="Portfolio - Mi Sitio Personal">
  <Navbar />
  
  <!-- Header con estilo manga -->
  <section class="py-16 bg-manga-cream relative overflow-hidden">
    <div class="absolute inset-0 screentone-light opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-6xl font-black text-manga-black mb-4 uppercase">
        <span class="inline-block border-b-6 border-accent-red pb-2">🎨 Portfolio</span>
      </h1>
      <p class="text-xl text-manga-dark-gray font-bold">Trabajos realizados y casos de éxito</p>
    </div>
  </section>

  <section class="py-16 bg-manga-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Categories Filter -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <button 
          class="filter-btn manga-button-red px-6 py-3 text-sm"
          data-category="all"
        >
          Todos
        </button>
        {categories.map((category) => (
          <button 
            class="filter-btn manga-button px-6 py-3 text-sm"
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {portfolioData.portfolio.map((item) => (
          <article 
            class="portfolio-item manga-panel manga-zoom panel-appear"
            data-category={item.category}
          >
            <div class="relative aspect-video bg-manga-light-gray overflow-hidden border-b-3 border-manga-black">
              <img 
                src={`${baseUrl}${item.image}`}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="hidden absolute inset-0 items-center justify-center bg-gradient-to-br from-primary-200 to-primary-400">
                <span class="text-6xl opacity-50">🎨</span>
              </div>
            </div>
            <div class="p-6 relative">
              <div class="absolute top-0 right-0 w-0 h-0 border-t-[30px] border-t-accent-red border-l-[30px] border-l-transparent"></div>
              <div class="flex justify-between items-start mb-3">
                <span class="px-3 py-1 bg-manga-black text-white text-xs font-black uppercase border-2 border-manga-black shadow-manga-sm">
                  {item.category}
                </span>
                <span class="text-sm text-manga-dark-gray font-bold">{item.year}</span>
              </div>
              <h3 class="text-xl font-black mb-2 text-manga-black uppercase">
                {item.title}
              </h3>
              <p class="text-manga-dark-gray mb-4 font-medium">{item.description}</p>
              {item.link && (
                <a 
                  href={item.link} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="manga-button text-sm inline-block"
                >
                  ⚡ Ver sitio
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const portfolioItems = document.querySelectorAll<HTMLElement>('.portfolio-item');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');
      
      // Update active button
      filterButtons.forEach(btn => {
        if (btn.classList.contains('manga-button-red')) {
          btn.classList.remove('manga-button-red');
          btn.classList.add('manga-button');
        }
      });
      if (button.classList.contains('manga-button')) {
        button.classList.remove('manga-button');
        button.classList.add('manga-button-red');
      }

      // Filter items
      portfolioItems.forEach(item => {
        if (category === 'all' || item.getAttribute('data-category') === category) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
