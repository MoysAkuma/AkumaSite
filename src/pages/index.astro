---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import profileData from '../data/profile.json';

const baseUrl = import.meta.env.BASE_URL || '/';
---

<BaseLayout title="Inicio - Mi Sitio Personal">
  <Navbar />
  
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-br from-primary-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="mb-8">
          <div class="w-32 h-32 mx-auto bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center text-white text-5xl font-bold">
            {profileData.name.charAt(0)}
          </div>
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          {profileData.name}
        </h1>
        <p class="text-2xl md:text-3xl text-primary-600 mb-6">
          {profileData.title}
        </p>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
          {profileData.bio}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`${baseUrl}portfolio`}
            class="px-8 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition font-medium"
          >
            Ver Portfolio
          </a>
          <a
            href={`${baseUrl}services`}
            class="px-8 py-3 bg-white text-primary-600 border-2 border-primary-600 rounded-lg hover:bg-primary-50 transition font-medium"
          >
            Mis Servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Habilidades</h2>
      <div class="flex flex-wrap justify-center gap-4">
        {profileData.skills.map((skill) => (
          <span class="px-6 py-3 bg-primary-100 text-primary-700 rounded-full font-medium">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Explora</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href={`${baseUrl}portfolio`} class="group p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition">
          <div class="text-4xl mb-4">🎨</div>
          <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 transition">Portfolio</h3>
          <p class="text-gray-600">Mis trabajos y proyectos realizados</p>
        </a>
        <a href={`${baseUrl}projects`} class="group p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition">
          <div class="text-4xl mb-4">💻</div>
          <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 transition">Proyectos</h3>
          <p class="text-gray-600">Proyectos de código abierto</p>
        </a>
        <a href={`${baseUrl}services`} class="group p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition">
          <div class="text-4xl mb-4">🚀</div>
          <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 transition">Servicios</h3>
          <p class="text-gray-600">Soluciones que ofrezco</p>
        </a>
        <a href={`${baseUrl}hobbies`} class="group p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition">
          <div class="text-4xl mb-4">🎮</div>
          <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 transition">Hobbies</h3>
          <p class="text-gray-600">Mis pasiones e intereses</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-6">¿Hablamos?</h2>
      <p class="text-lg text-gray-600 mb-8">
        Estoy disponible para nuevos proyectos y colaboraciones
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={profileData.social.email}
          class="px-8 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition font-medium"
        >
          📧 Enviar Email
        </a>
        {profileData.social.linkedin && (
          <a
            href={profileData.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
          >
            LinkedIn
          </a>
        )}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
