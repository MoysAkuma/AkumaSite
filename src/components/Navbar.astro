---
const baseUrl = import.meta.env.BASE_URL || '/';
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'Proyectos', href: '/projects' },
  { name: 'Servicios', href: '/services' },
  { name: 'Hobbies', href: '/hobbies' },
];
---

<nav class="bg-manga-cream border-b-5 border-manga-black sticky top-0 z-50 shadow-manga">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 flex items-center group">
          <span class="text-3xl font-black text-manga-black tracking-tight uppercase transform transition-transform group-hover:scale-110">
            ⚡ AkumaSite
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex md:items-center md:space-x-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 text-sm font-bold uppercase tracking-wide transition-all border-3 ${
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'bg-accent-red text-gray-900 border-manga-black shadow-manga-sm transform -translate-y-1'
                : 'bg-white text-manga-black border-manga-black hover:shadow-manga-sm hover:-translate-y-1'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          class="inline-flex items-center justify-center p-2 bg-white border-3 border-manga-black hover:shadow-manga-sm transition-all"
          aria-expanded="false"
        >
          <span class="sr-only">Abrir menú</span>
          <svg class="h-6 w-6 stroke-manga-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t-3 border-manga-black bg-manga-paper">
    <div class="px-2 pt-2 pb-3 space-y-2 sm:px-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-4 py-3 text-base font-bold uppercase tracking-wide transition-all border-3 ${
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'bg-accent-red text-gray-900 border-manga-black shadow-manga-sm'
              : 'bg-white text-manga-black border-manga-black hover:shadow-manga-sm'
          }`}
        >
          {item.name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
    mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
